# Keep the build context small and free of local state/secrets.
**/node_modules
**/dist
**/data
**/.app-secret
**/FIRST-ADMIN-SETUP.txt
**/*.log

.git
.gitignore
.firebaserc
.env
.env.*
*.db
*.db-*
*.sqlite
*.sqlite3
docs
images

# Deployment-only assets that are not needed inside the image.
deploy/hosting
firebase.json
docs/DEPLOYMENT.md
