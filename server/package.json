{
  "name": "@chorale/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-db-assets.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:admins": "tsx src/db/seed-admins.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.712.0",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
